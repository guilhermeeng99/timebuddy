{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "timebuddy-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "5599",
        "--web-hostname",
        "localhost"
      ],
      "port": 5599,
      "url": "http://localhost:5599"
    },
    {
      "name": "timebuddy-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5600",
        "--bind",
        "localhost",
        "--directory",
        "build/web"
      ],
      "port": 5600,
      "url": "http://localhost:5600"
    }
  ]
}
